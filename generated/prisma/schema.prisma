generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model audit_logs {
  id         String   @id
  adminId    String
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
}

model bookings {
  id             String         @id
  leadId         String
  tutorProfileId String
  parentName     String?
  tutorName      String?
  subject        String
  classLevel     String
  mode           TeachingMode
  status         BookingStatus  @default(REQUESTED)
  startDate      DateTime?
  classFrequency String?
  meetLink       String?
  venueAddress   String?
  agreedFee      Int?
  isTrial        Boolean        @default(false)
  cancelledBy    String?
  cancelReason   String?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  leads          leads          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tutor_profiles tutor_profiles @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  reviews        reviews[]

  @@index([tutorProfileId, status])
}

model coin_packages {
  id         String   @id
  name       String
  coins      Int
  bonusCoins Int      @default(0)
  priceInr   Int
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model lead_purchases {
  id             String         @id
  leadId         String
  tutorProfileId String
  coinsSpent     Int
  proposalNote   String?
  feeQuote       Int?
  isShortlisted  Boolean        @default(false)
  isHired        Boolean        @default(false)
  isRejected     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  leads          leads          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tutor_profiles tutor_profiles @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([leadId, tutorProfileId])
  @@index([tutorProfileId])
}

model leads {
  id               String           @id
  parentProfileId  String
  studentProfileId String?
  subjects         String[]
  classLevel       String
  board            String?
  mode             TeachingMode
  budgetMin        Int?
  budgetMax        Int?
  latitude         Float?
  longitude        Float?
  city             String?
  area             String?
  timingPreference String?
  tutorGenderPref  String?
  languagePref     String?
  notes            String?
  status           LeadStatus       @default(ACTIVE)
  coinCost         Int              @default(10)
  maxTutors        Int              @default(5)
  purchaseCount    Int              @default(0)
  radiusKm         Int              @default(10)
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  pincode          String?
  bookings         bookings[]
  lead_purchases   lead_purchases[]
  parent_profiles  parent_profiles  @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)

  @@index([classLevel, status])
  @@index([parentProfileId, createdAt])
  @@index([status, createdAt])
}

model notifications {
  id        String              @id
  userId    String
  title     String
  message   String
  channel   NotificationChannel @default(WEB)
  isRead    Boolean             @default(false)
  actionUrl String?
  createdAt DateTime            @default(now())
  users     users               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model parent_profiles {
  id               String             @id
  userId           String             @unique
  city             String?
  state            String?
  pincode          String?
  address          String?
  latitude         Float?
  longitude        Float?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  leads            leads[]
  users            users              @relation(fields: [userId], references: [id], onDelete: Cascade)
  student_profiles student_profiles[]
}

model platform_settings {
  id    String  @id
  key   String  @unique
  value String
  label String?
}

model reviews {
  id                  String         @id
  bookingId           String
  tutorProfileId      String
  reviewerUserId      String
  reviewerRole        UserRole
  teachingRating      Int?
  communicationRating Int?
  punctualityRating   Int?
  overallRating       Int
  comment             String?
  isEditable          Boolean        @default(true)
  editLockedAt        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime
  bookings            bookings       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tutor_profiles      tutor_profiles @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([bookingId, reviewerUserId])
}

model sessions {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model student_profiles {
  id              String          @id
  parentProfileId String
  name            String
  classLevel      String
  board           String?
  subjects        String[]
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  parent_profiles parent_profiles @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)

  @@index([parentProfileId])
}

model tutor_availability {
  id             String         @id
  tutorProfileId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  tutor_profiles tutor_profiles @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
}

model tutor_profiles {
  id                 String               @id
  userId             String               @unique
  bio                String?
  qualification      String?
  experience         Int?
  subjects           String[]
  classLevels        String[]
  teachingMode       TeachingMode         @default(EITHER)
  teachingRadius     Int                  @default(10)
  feeMin             Int?
  feeMax             Int?
  latitude           Float?
  longitude          Float?
  city               String?
  state              String?
  introVideoUrl      String?
  profileScore       Int                  @default(0)
  averageRating      Float                @default(0)
  totalReviews       Int                  @default(0)
  isVerified         Boolean              @default(false)
  kycStatus          KycStatus            @default(NOT_SUBMITTED)
  kycIdProofUrl      String?
  kycAddressUrl      String?
  kycSelfieUrl       String?
  kycRejectionNote   String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  bookings           bookings[]
  lead_purchases     lead_purchases[]
  reviews            reviews[]
  tutor_availability tutor_availability[]
  users              users                @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallets            wallets?
}

model users {
  id              String           @id
  name            String?
  email           String           @unique
  emailVerified   DateTime?
  passwordHash    String?
  phone           String?          @unique
  image           String?
  role            UserRole         @default(PARENT)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  subAdminRole    SubAdminRole?
  accounts        accounts[]
  notifications   notifications[]
  parent_profiles parent_profiles?
  sessions        sessions[]
  tutor_profiles  tutor_profiles?
}

model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model wallet_transactions {
  id           String                @id
  walletId     String
  type         WalletTransactionType
  amount       Int
  balanceAfter Int
  description  String?
  referenceId  String?
  createdAt    DateTime              @default(now())
  wallets      wallets               @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model wallets {
  id                  String                @id
  tutorProfileId      String                @unique
  balance             Int                   @default(0)
  totalPurchased      Int                   @default(0)
  totalSpent          Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  wallet_transactions wallet_transactions[]
  tutor_profiles      tutor_profiles        @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum LeadStatus {
  ACTIVE
  MATCHING
  APPLICATIONS_RECEIVED
  BOOKED
  COMPLETED
  EXPIRED
  CLOSED
}

enum NotificationChannel {
  WEB
  EMAIL
}

enum SubAdminRole {
  SUPPORT
  VERIFICATION
  FINANCE
  OPERATIONS
  MARKETING
}

enum TeachingMode {
  ONLINE
  OFFLINE
  EITHER
}

enum UserRole {
  PARENT
  TUTOR
  SUPER_ADMIN
  SUB_ADMIN
}

enum WalletTransactionType {
  PURCHASE
  DEDUCTION
  REFUND
  BONUS
  ADMIN_CREDIT
  ADMIN_DEBIT
}

model BetaLead {
  id         String  @id @default(cuid())
  name       String
  email      String  @unique
  phone      String  @unique
  role       String // PARENT | TUTOR
  city       String
  notes      String?
  status     String  @default("HOLD") // HOLD | CONTACTED | ACTIVE | BLOCKED
  adminNotes String?

  // Extended Profile & Verification Details (Manual Onboarding CRM)
  qualification      String? // e.g. B.Tech / M.Sc Mathematics / B.Ed
  experience         String? // e.g. 5+ Years, Ex-Allen Faculty
  subjects           String? // e.g. Class 10 Math, Physics, NEET
  teachingMode       String? // e.g. Home Tuition / Online / Both
  studentGrade       String? // e.g. Class 10 CBSE / Grade 8
  budget             String? // e.g. ₹500/hr or ₹10,000/mo
  address            String? // Detailed Address / Landmark
  locality           String? // Area / Suburb e.g. Kothrud, Wakad, Indiranagar
  pincode            String? // Pincode e.g. 411038
  preferredLocations String? // Travel radius / target areas e.g. Kothrud, Deccan, Online
  languages          String? // Medium of instruction e.g. English, Hindi, Marathi
  documentsStatus    String? @default("PENDING") // PENDING | VERIFIED | REJECTED | NOT_REQUIRED
  documentsNotes     String? // ID Proof / Degree / Verification notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
